{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_OVOK_MOCK": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_OVOK_MOCK": "1"
      }
    },
    "testflight": {
      "distribution": "store",
      "channel": "preview",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_OVOK_MOCK": "1"
      }
    },
    "production": {
      "channel": "production",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_OVOK_MOCK": "1"
      }
    },
    "play-internal": {
      "distribution": "store",
      "channel": "preview",
      "autoIncrement": false,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_OVOK_MOCK": "1"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "appleTeamId": "TR4973K4Q2"
      }
    },
    "production": {
      "ios": {
        "appleTeamId": "TR4973K4Q2"
      }
    }
  }
}
