# Ovok tenant
OVOK_API_URL=https://api.ovok.com
OVOK_TENANT_CODE=

# Server auth: prefer client credentials for deployed bots.
# OVOK_ACCESS_TOKEN is only for a short-lived local smoke test.
OVOK_CLIENT_ID=
OVOK_CLIENT_SECRET=
OVOK_TOKEN_URL=
OVOK_ACCESS_TOKEN=
OVOK_SCOPE=

# FHIR client tuning
OVOK_REQUEST_TIMEOUT_MS=15000
OVOK_MAX_RETRIES=2

# Expo push (server-side delivery)
EXPO_ACCESS_TOKEN=
TAKT_PUSH_CHANNEL_ID=family-share

# Bot scheduling / safety
TAKT_DEFAULT_TIMEZONE=UTC
TAKT_QUIET_HOURS_START=21
TAKT_QUIET_HOURS_END=8
TAKT_UNCONFIRMED_HOURS=2
TAKT_MAX_AGE_HOURS=26
TAKT_BOT_CONCURRENCY=4

# Bot identifiers registered in the Ovok tenant
TAKT_FAMILY_SHARE_BOT_ID=
TAKT_UNCONFIRMED_BOT_ID=
TAKT_ERASE_BOT_ID=

# Manual A/B isolation checks; never commit real values.
OVOK_PATIENT_A_TOKEN=
OVOK_PATIENT_B_TOKEN=
OVOK_PATIENT_A_ID=
OVOK_PATIENT_B_ID=
