{
  "name": "ovok-mobile-app",
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "expo export --platform web",
    "update:preview": "eas update --channel preview --platform all --environment preview --non-interactive",
    "build:testflight": "eas build --platform ios --profile testflight --non-interactive",
    "build:testflight:live": "eas build --platform ios --profile testflight-live --non-interactive",
    "submit:testflight": "eas submit --platform ios --profile testflight --latest --non-interactive",
    "submit:testflight:live": "eas submit --platform ios --profile testflight-live --latest --non-interactive",
    "build:android:live": "eas build --platform android --profile play-internal-live --non-interactive",
    "submit:android:live": "eas submit --platform android --profile play-internal-live --latest --non-interactive",
    "verify:adherence": "npx -y tsx scripts/verify-adherence-fixtures.ts",
    "verify:form": "npx -y tsx scripts/verify-form-model.ts",
    "verify:report": "npx -y tsx scripts/verify-report-parity.ts",
    "verify:fhir": "npx -y tsx scripts/verify-fhir-integrity.ts",
    "verify:live": "npx -y tsx scripts/verify-live.ts",
    "verify": "npm run -s verify:adherence && npm run -s verify:form && npm run -s verify:report && npm run -s verify:fhir",
    "postinstall": "node scripts/fix-ios-paths.js"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@medplum/core": "^4.3.6",
    "@medplum/expo-polyfills": "^4.3.6",
    "@medplum/fhirtypes": "^4.3.6",
    "@medplum/react-hooks": "^4.3.6",
    "@ovok/core": "^0.4.42",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "^5.60.5",
    "expo": "~57.0.31",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.24",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-standard-web-crypto": "^57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.22",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "babel-preset-expo": "^57.0.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "private": true,
  "overrides": {
    "react-dom": "$react-dom",
    "react-native-screens": "$react-native-screens"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-screens"
      ]
    }
  }
}
