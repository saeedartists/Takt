{
  "name": "ovok-mobile-app",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform web",
    "update:preview": "eas update --channel preview --platform all --environment preview --non-interactive",
    "build:testflight": "eas build --platform ios --profile testflight --non-interactive",
    "submit:testflight": "eas submit --platform ios --profile testflight --latest --non-interactive",
    "verify:adherence": "npx -y tsx scripts/verify-adherence-fixtures.ts",
    "verify:report": "npx -y tsx scripts/verify-report-parity.ts",
    "verify:fhir": "npx -y tsx scripts/verify-fhir-integrity.ts",
    "verify": "npm run -s verify:adherence && npm run -s verify:report && npm run -s verify:fhir"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@medplum/expo-polyfills": "^3.2.23",
    "@ovok/core": "^0.2.51",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "^5.60.5",
    "expo": "~57.0.23",
    "expo-build-properties": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.19",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.20",
    "expo-splash-screen": "~57.0.9",
    "expo-standard-web-crypto": "^57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.22",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "^57.0.11",
    "typescript": "^6.0.3"
  },
  "private": true,
  "overrides": {
    "react-dom": "$react-dom",
    "react-native-screens": "$react-native-screens"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-screens"
      ]
    }
  }
}
