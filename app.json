{
  "expo": {
    "name": "Takt Health",
    "slug": "saeed",
    "scheme": "takt",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.actimi.takt",
      "buildNumber": "4",
      "infoPlist": {
        "CFBundleDisplayName": "Takt Health",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "TR4973K4Q2"
    },
    "android": {
      "package": "com.actimi.takt",
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ],
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1218"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/d4b1c55c-cddf-4e3e-a188-25ebbe9388ba",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-notifications",
        {
          "color": "#B4611C",
          "sounds": [
            "./assets/sounds/takt_reminder.wav"
          ],
          "mode": "production"
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF9",
          "dark": {
            "backgroundColor": "#0E1218"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d4b1c55c-cddf-4e3e-a188-25ebbe9388ba"
      }
    },
    "owner": "saeedartists1s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "icon": "./assets/icon.png"
  }
}
