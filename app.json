{
  "expo": {
    "name": "Takt",
    "slug": "saeed",
    "scheme": "takt",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.actimi.takt"
    },
    "android": {
      "package": "com.actimi.takt",
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "updates": {
      "url": "https://u.expo.dev/d4b1c55c-cddf-4e3e-a188-25ebbe9388ba",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-notifications",
        {
          "color": "#B4611C",
          "sounds": []
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "notification": {
      "color": "#B4611C"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d4b1c55c-cddf-4e3e-a188-25ebbe9388ba"
      }
    },
    "owner": "saeedartists1s-team"
  }
}
