{
  "expo": {
    "name": "Takt",
    "slug": "takt",
    "scheme": "takt",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.actimi.takt"
    },
    "android": {
      "package": "com.actimi.takt",
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#B4611C",
          "sounds": []
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "notification": {
      "color": "#B4611C"
    }
  }
}
