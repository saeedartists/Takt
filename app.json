{
  "expo": {
    "name": "Takt",
    "slug": "saeed",
    "scheme": "takt",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.actimi.takt",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.actimi.takt",
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ],
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#B4611C"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/d4b1c55c-cddf-4e3e-a188-25ebbe9388ba",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-notifications",
        {
          "color": "#B4611C",
          "sounds": []
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F9F8F5",
          "dark": {
            "backgroundColor": "#0B0F15"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d4b1c55c-cddf-4e3e-a188-25ebbe9388ba"
      }
    },
    "owner": "saeedartists1s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "icon": "./assets/icon.png"
  }
}
